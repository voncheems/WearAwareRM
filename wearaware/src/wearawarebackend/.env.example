NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wearaware?replicaSet=wearaware-rs
MONGODB_DB=wearaware
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set only the exact proxy trust rule used by the host in production.
# Render's web-service proxy is one hop: TRUST_PROXY=1
# For local reverse proxies, use exact IPs/subnets, for example:
# TRUST_PROXY=127.0.0.1/32,::1/128
AI_API_URL=http://127.0.0.1:8000
AI_API_KEY=replace-with-the-same-random-secret-as-the-python-service
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAIL=
# Migration-only PostgreSQL configuration; do not give these credentials to the production runtime.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wearaware
DB_USER=
DB_PASSWORD=
# Provisioning-only MongoDB credential for npm run db:secure; remove after use.
# MONGODB_ADMIN_URI=
